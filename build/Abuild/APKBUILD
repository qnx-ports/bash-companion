pkgname=bash
_basever=5.3
_patchlevel=3
pkgver="$_basever.$_patchlevel"
pkgrel=4
pkgdesc="The GNU Bourne Again shell"
url="https://git.savannah.gnu.org/cgit/bash.git/"
arch="all"
license="GPL-3.0-or-later"
options="!check"
depends="ncurses readline qnx-io-sock libintl libiconv"
makedepends="ncurses-dev readline-dev qnx-io-sock-dev gettext-dev libiconv-dev"
depends_dev=$makedepends
subpackages="${pkgname}-doc ${pkgname}-lang"
source="https://mirror.csclub.uwaterloo.ca/gnu/bash/bash-$_basever.tar.gz
	bash53-001.patch::https://mirror.csclub.uwaterloo.ca/gnu/bash/bash-5.3-patches/bash53-001
	bash53-002.patch::https://mirror.csclub.uwaterloo.ca/gnu/bash/bash-5.3-patches/bash53-002
	bash53-003.patch::https://mirror.csclub.uwaterloo.ca/gnu/bash/bash-5.3-patches/bash53-003
    fix-qnx.patch
    system.bashrc
	dot.bashrc dot.bash_profile dot.bash_logout
"
provides="/bin/sh"
builddir="$srcdir"/bash-"$_basever"

prepare() {
    default_prepare
    # preventively set Version to please 'apk version --check'
    sed -i "s/@PACKAGE_VERSION@/$pkgver/" "$builddir"/support/bash.pc.in
}

build() {
    CFLAGS="$CFLAGS -O2 -Wl,-lregex,--stack,8388608" \
    ./configure \
        --build="$CBUILD" \
        --host="$CHOST" \
        --prefix=/usr \
        --enable-readline \
        --without-bash-malloc \
        --with-installed-readline
    make
}

package() {
    make DESTDIR="${pkgdir}" install
    ln -s bash "$pkgdir"/usr/bin/sh
    install -Dm644 "$srcdir"/system.bashrc "$pkgdir"/etc/bash.bashrc
	
	# user home folder skeleton
	install -dm755 "$pkgdir"/etc/skel/
	install -m644 "$srcdir"/dot.bashrc "$pkgdir"/etc/skel/.bashrc
 	install -m644 "$srcdir"/dot.bash_profile "$pkgdir"/etc/skel/.bash_profile
 	install -m644 "$srcdir"/dot.bash_logout "$pkgdir"/etc/skel/.bash_logout
}

